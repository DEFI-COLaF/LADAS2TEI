			<div1 type="specifications">
				<schemaSpec ident="ladas" start="TEI" prefix="tei_" targetLang="en" docLang="en">

					<!-- LIST OF MODULES -->
					<moduleRef key="tei"/>
					<moduleRef key="header"/>
					<moduleRef key="core"/>
					<moduleRef key="textstructure"/>
					<moduleRef key="drama"/>
					<moduleRef key="msdescription"/>
					<moduleRef key="transcr"/>
					<moduleRef key="figures"/>
					<moduleRef key="linking"/>

					<!-- CHANGES BY ALPHABETICAL ORDER OF ELEMENTS  -->
					<elementSpec ident="ab" mode="change">
						<attList>
							<attDef ident="type" mode="add" usage="rec">
								<valList>
									<valItem ident="digitisation-artefact"/>
								</valList>
							</attDef>
							<attDef ident="rend" mode="add" usage="rec">
								<valList>
									<valItem ident="continued"/>
								</valList>
							</attDef>
						</attList>
					</elementSpec>

					<elementSpec ident="figure" mode="change">
						<attList>
							<attDef ident="type" mode="add" usage="rec">
								<valList>
									<valItem ident="code"/>
									<valItem ident="decoration"/>
									<valItem ident="maths"/>
								</valList>
							</attDef>
						</attList>
					</elementSpec>

					<elementSpec ident="fw" mode="change">
						<attList>
							<attDef ident="type" mode="add" usage="rec">
								<valList mode="add" type="closed">
									<valItem ident="running-title"/>
									<valItem ident="quiremarks"/>
								</valList>
							</attDef>
						</attList>
					</elementSpec>

					<elementSpec ident="note" mode="change">
						<attList>
							<attDef ident="type" mode="add" usage="rec">
								<valList mode="add" type="closed">
									<valItem ident="handwritten"/>
								</valList>
							</attDef>
						</attList>
					</elementSpec>

					<elementSpec ident="p" mode="change">
						<attList>
							<attDef ident="rend" mode="add" usage="rec">
								<valList mode="add" type="closed">
									<valItem ident="styled"/>
								</valList>
							</attDef>
							<attDef ident="type" mode="add" usage="rec">
								<valList>
									<valItem ident="labelled"/>
									<valItem ident="structured"/>
								</valList>
							</attDef>
						</attList>
					</elementSpec>

					<!-- SCHEMATRON RULES -->
					<!-- <titlePage> or <div type="title-page"> -->
					<!-- <bibl> or <p type="structured"> -->

				</schemaSpec>
			</div1>
